# Native frontend development: Vite proxies /api to http://127.0.0.1:8000.
# Google sign-in reads the public GOOGLE_CLIENT_ID from the backend at runtime.
# Leave blank for same-origin API (recommended).
VITE_BACKEND_URL=
# Optional Vite config values:
# API_PROXY_TARGET=http://127.0.0.1:8000
# VITE_ALLOWED_HOSTS=localhost,your-preview-domain.example
