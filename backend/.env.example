# For native development: copy to backend/.env, set credentials, then alembic upgrade head.
ENV=development
DATABASE_URL=postgresql+asyncpg://codeos:CHANGE_ME@localhost:5432/codeos
JWT_SECRET=
JWT_EXPIRY_HOURS=24
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_REQUESTS_PER_MINUTE=5
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
AI_TIMEOUT_SECONDS=90
INTERACTIVE_TIMEOUT_SECONDS=105
S3_BUCKET=codeos-archives
S3_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=codeos
AWS_SECRET_ACCESS_KEY=
S3_ENCRYPTION=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=codeos_gemini_768_v1
WORKER_ENABLED=true
JOB_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
INGEST_TIMEOUT_SECONDS=1800
MAX_ARCHIVE_BYTES=209715200
MAX_EXTRACT_BYTES=524288000
MAX_FILES=20000
MAX_SOURCE_BYTES=500000
MAX_REPOSITORIES_PER_USER=30
MAX_COMPRESSION_RATIO=200
