# Run python scripts/configure.py to create .env with random local credentials.
# Add a real Gemini API key. No paid service keys are included in the archive.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_REQUESTS_PER_MINUTE=5
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Conservative shared budget; real project quotas may be lower.
EMBEDDING_REQUESTS_PER_MINUTE=5
EMBEDDING_INPUTS_PER_MINUTE=40
EMBEDDING_TOKENS_PER_MINUTE=8000
QDRANT_COLLECTION=codeos_gemini_768_v1
JWT_SECRET=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MINIO_ROOT_USER=codeos
MINIO_ROOT_PASSWORD=
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
